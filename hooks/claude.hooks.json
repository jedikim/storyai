{
  "SessionStart": [
    {
      "hooks": [
        { "type": "command",
          "command": "$CLAUDE_PROJECT_DIR/hooks/run-check.sh book",
          "timeout": 30 }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "mcp__storyai__commit",
      "hooks": [
        { "type": "command",
          "command": "$CLAUDE_PROJECT_DIR/hooks/run-check.sh changed",
          "timeout": 60 }
      ]
    }
  ]
}
